#!/usr/bin/env bash
# by Andrey A. Ugolnik
# https://github.com/reybits

# check if tmux server is running
tmux_running=$(tmux list-sessions 2>/dev/null)

if [[ $# -eq 1 ]]; then
    path=$1
else
    my_find() {
        if [[ -n $TMUX ]] || [[ -n $tmux_running ]]; then
            SESSIONS=""
            CURRENT_SESSION=$(tmux display-message -p '#S')

            # sessions that currently have a waiting-claude marker; newline
            # delimited so the membership test below is exact and space-safe
            WAITING=$'\n'
            marker_dir="${CLAUDE_WAITING_DIR:-/tmp/tmux-claude-waiting-${UID}}"
            if [[ -d $marker_dir ]]; then
                pane_map=$(tmux list-panes -a -F '#{pane_id} #{session_name}' 2>/dev/null)
                for marker in "$marker_dir"/*; do
                    [[ -e $marker ]] || continue
                    marked=$(printf '%s\n' "$pane_map" | awk -v p="$(basename "$marker")" '$1 == p { s = $2; for (i = 3; i <= NF; i++) s = s " " $i; print s; exit }')
                    [[ -n $marked ]] && WAITING="$WAITING$marked"$'\n'
                done
            fi

            # sort by most recent use so the previous session lands first
            while IFS= read -r session; do
                if [[ $session == "$CURRENT_SESSION" ]]; then
                    continue
                fi
                if [[ $WAITING == *$'\n'"$session"$'\n'* ]]; then
                    SESSIONS="$SESSIONS\033[1;34m* $session\033[0m \033[1;31m✻\033[0m\n"
                else
                    SESSIONS="$SESSIONS\033[1;34m* $session\033[0m\n"
                fi
            done < <(tmux list-sessions -F "#{session_last_attached} #{session_name}" 2>/dev/null | sort -rn | cut -d' ' -f2-)
            echo -e "$SESSIONS"
        fi

        if [[ -z $SESSION_PATHS ]]; then
            echo -e "\033[31m! Env SESSION_PATHS is not set.\033[0m"
        else
            IFS=':' read -r -a PATHS_LIST <<<"$SESSION_PATHS"
            for path in "${PATHS_LIST[@]}"; do
                find "$path" -mindepth 1 -maxdepth 1 -type d -not -path "$path/.git" 2>/dev/null
            done
        fi
    }

    path=$(
        my_find |
            fzf \
                --tmux 90%,80% \
                --ansi \
                --no-sort \
                --preview "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/bin/tmux-fzf-preview {}"
    )
fi

# nothing selected
if [[ -z $path ]]; then
    exit 0
fi

# remove leading '* ' and any trailing waiting marker from the session name
if [[ $path == \** ]]; then
    path=${path:2}
    path=${path% ✻}
fi

# format session name
selected_name=$(basename "$path" | tr -s ".[:blank:]" "-" | tr "[:upper:]" "[:lower:]")

# create new session if tmux is not running or if session not exists
if [[ -z $TMUX && -z $tmux_running ]] || ! tmux has-session -t "$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$path"
fi

if [[ -z $TMUX ]]; then
    # attach to session outside tmux
    tmux attach-session -t "$selected_name"
else
    # switch to session
    tmux switch-client -t "$selected_name"
fi
